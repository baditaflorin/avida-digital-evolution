{
  "name": "avida-digital-evolution",
  "version": "0.1.0",
  "description": "Browser-based artificial life sandbox where WASM organisms evolve, render, and get narrated locally.",
  "type": "module",
  "private": false,
  "scripts": {
    "dev": "npm run build:wasm && vite --host 0.0.0.0",
    "build": "node scripts/clean-pages.mjs && node scripts/build-info.mjs && npm run build:wasm && vite build && cp docs/index.html docs/404.html",
    "build:wasm": "node scripts/build-wasm.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint . && prettier --check . && tsc --noEmit",
    "fmt": "prettier --write .",
    "pages-preview": "npx http-server docs -a 127.0.0.1 -p 4173 -c-1",
    "smoke": "bash scripts/smoke.sh",
    "audit": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.30.0",
    "@tanstack/query-core": "^5.90.12",
    "comlink": "^4.4.2",
    "lucide": "^1.14.0",
    "three": "^0.181.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.10.2",
    "@types/three": "^0.184.1",
    "@webgpu/types": "^0.1.69",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "http-server": "^14.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "prettier": "^3.7.4",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
